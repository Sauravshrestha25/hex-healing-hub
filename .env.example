# PostgreSQL. Credentials are URL-encoded automatically, so any password characters are fine.
# (Alternatively set DATABASE_URL, which takes precedence, e.g. in .env.local for local dev.)
DB_HOST="localhost"
DB_PORT="5432"
DB_USER=""
DB_PASSWORD=""
DB_NAME="hexdb"
# Redis (shared login / contact-form rate limits). Leave REDIS_HOST empty to use in-memory limits.
# In Docker, docker-compose.yml sets DB_HOST / REDIS_HOST to webx-postgres / webx-redis.
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""   # only if webx-redis was started with a password
# Public origin of the site (used for metadata, sitemap and absolute links)
SITE_URL="https://yourdomain.com"

# Owner (superadmin) account, created by `pnpm db:seed`. Hidden from other admins in the dashboard.
# Generate the hash with:  pnpm admin:hash "a-long-password"   (paste the printed line as-is)
# To change the owner's email/password later, update these and run:  SUPERADMIN_RESET=1 pnpm db:seed
SUPERADMIN_NAME="Site Owner"
SUPERADMIN_EMAIL="owner@yourdomain.com"
SUPERADMIN_PASSWORD_HASH=""
# Random string, 32+ chars (e.g. `openssl rand -base64 48`). Signs the login session cookie.
SESSION_SECRET=""

# Cloudflare R2 (S3-compatible) image storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public URL of the bucket, e.g. https://pub-xxxx.r2.dev or https://images.yourdomain.com
R2_PUBLIC_BASE_URL=""

# SMTP for new-inquiry notification emails
SMTP_HOST=""
# 587 = STARTTLS, 465 = implicit TLS
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HEX Healing Hub <no-reply@yourdomain.com>"
INQUIRY_NOTIFY_TO="Hexhealinghub@gmail.com"
