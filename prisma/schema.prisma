generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String
  /// Sanitised HTML for the service's own page (/services/[slug]).
  content     String          @default("")
  image       String
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  healers     HealerService[]
}

model Blog {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  category    String
  coverImage  String
  /// Sanitised HTML produced by the admin rich-text editor.
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model GalleryItem {
  id        String   @id @default(cuid())
  image     String
  title     String
  category  String
  alt       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

enum BookingStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Booking requests from /book. Visitors ask for a day and time of day; the team confirms by phone
/// or WhatsApp. (Formerly the contact form's Inquiry table: old rows keep their email and message.)
model Booking {
  id            String        @id @default(cuid())
  name          String
  phone         String?
  email         String?
  service       String?
  centre        String?
  preferredDate DateTime?     @db.Date
  /// "Morning" | "Afternoon" | "Evening"
  timeOfDay     String?
  note          String?
  status        BookingStatus @default(NEW)
  createdAt     DateTime      @default(now())

  /// Short code shown to the visitor and quoted in confirmations, e.g. "HEX-7K2P9Q".
  reference       String?   @unique
  /// Set for bookings made with a specific healer in a real time slot (general requests leave these empty).
  healerId        String?
  healer          Healer?   @relation(fields: [healerId], references: [id], onDelete: SetNull)
  /// Slot start (a UTC instant; shown in Nepal time).
  startsAt        DateTime?
  durationMinutes Int?
  /// Price quoted at booking time, in Nepali rupees.
  price           Int?

  @@index([status, createdAt])
  @@index([healerId, startsAt])
}

/// A practitioner visitors can read about and book ("Our Healers").
model Healer {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  /// Speciality line under the name, e.g. "Hypnotherapist & Energy Healer".
  title           String
  bio             String
  photo           String?
  experienceYears Int      @default(0)
  /// One qualification per line.
  qualifications  String   @default("")
  /// Comma-separated, e.g. "Nepali, English".
  languages       String   @default("")
  /// Where they see people: centre names and/or "Online".
  places          String[]
  published       Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services     HealerService[]
  availability HealerAvailability[]
  timeOff      HealerTimeOff[]
  bookings     Booking[]
  testimonials Testimonial[]

  @@index([published, order])
}

/// A service a healer offers, with their own price and session length.
model HealerService {
  id              String  @id @default(cuid())
  healerId        String
  serviceId       String
  /// Nepali rupees.
  price           Int
  durationMinutes Int
  healer          Healer  @relation(fields: [healerId], references: [id], onDelete: Cascade)
  service         Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([healerId, serviceId])
}

/// Weekly working hours: one window per weekday, in minutes from midnight, Nepal time.
model HealerAvailability {
  id          String @id @default(cuid())
  healerId    String
  /// 0 = Sunday … 6 = Saturday.
  weekday     Int
  startMinute Int
  endMinute   Int
  healer      Healer @relation(fields: [healerId], references: [id], onDelete: Cascade)

  @@unique([healerId, weekday])
}

/// A calendar day (Nepal) the healer is not available: leave, holidays.
model HealerTimeOff {
  id       String   @id @default(cuid())
  healerId String
  date     DateTime @db.Date
  healer   Healer   @relation(fields: [healerId], references: [id], onDelete: Cascade)

  @@unique([healerId, date])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  quote     String
  photo     String?
  service   String?
  centre    String?
  /// 1–5 stars.
  rating    Int      @default(5)
  /// The healer this review is about, if any: feeds their rating.
  healerId  String?
  healer    Healer?  @relation(fields: [healerId], references: [id], onDelete: SetNull)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// A common question shown on the Services and Contact pages.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

enum Role {
  SUPERADMIN
  ADMIN
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String
  phone          String?
  passwordHash   String
  /// Unverified users can sign in and view, but every change is refused server-side.
  isVerified     Boolean              @default(false)
  resetTokens    PasswordResetToken[]
  role           Role                 @default(ADMIN)
  /// Bumped on password change or removal so existing session cookies stop working.
  sessionVersion Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

/// One-time "forgot password" links. Only a SHA-256 of the token is stored.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
